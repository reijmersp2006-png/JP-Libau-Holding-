# Map van de holding met data/holding.sqlite3 (bijv. een checkout van de paper-data-branch)
NEXUS_HOLDING_HOME=../../paper-data
# Of: expliciete demo-omgeving met nep-koersen (alles gelabeld als SIMULATED)
# NEXUS_DEMO=1
# Opslag van NEXUS zelf. Productie: postgresql+psycopg://nexus:...@localhost:5432/nexus
NEXUS_DATABASE_URL=sqlite:///./nexus.db
# Nodig om de noodstop op te heffen of de modus te wijzigen. Lang en willekeurig; nooit committen.
NEXUS_ADMIN_TOKEN=
NEXUS_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Risicogrenzen kunnen alleen strenger, bijv.:
# NEXUS_RISK_MAX_MEME_PCT=0.02
# Fase 3 (nog niet gebruikt): ANTHROPIC_API_KEY=
